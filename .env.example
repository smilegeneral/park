# .env.local
# 注意：连接串【不要带】sslmode=verify-full —— pg v8 下无 Aiven CA 会握手失败
#（lib/db.ts 会自动剥离 sslmode 并跳过证书链校验，适合开发）
AIVEN_URL=postgres://avnadmin:密码@主机:端口/defaultdb

# ✅ NextAuth v4 专用（必须叫这个）
NEXTAUTH_URL=http://localhost:3000
# 用 `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"` 生成
NEXTAUTH_SECRET=这里填真实随机密钥