# ===== 数据库（Aiven PostgreSQL） =====
AIVEN_URL=postgres://user:pass@host:port/dbname

# ===== NextAuth v4 =====
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# ===== Cloudflare R2 对象存储（车位分布图，公开读） =====
# Cloudflare 账户 ID（dashboard 右下角或 r2.cloudflarestorage.com 子域名）
R2_ACCOUNT_ID=
# R2 API 令牌的 Access Key ID / Secret（R2 -> Manage API Tokens -> Create）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 存储桶名称（需在桶设置中开启"公开访问 / Allow Access from the Internet"）
R2_BUCKET=parking-system
# 公开访问基础 URL（自定义域 或 https://<accountid>.r2.cloudflarestorage.com/<bucket>）
# 图片将以此为基础拼接：<R2_PUBLIC_URL>/garage-maps/A区.jpg
R2_PUBLIC_URL=

# ===== AI 智能问数（统计报表页 → AI 智能问数） =====
# 优先级：「用户与角色 → AI 配置」中存库的配置 > 下面的环境变量兜底
# 服务商预设：groq(默认，免费额度) / gemini / siliconflow / deepseek / openai
AI_PROVIDER=groq
# API Key，免费申请示例：Groq https://console.groq.com/keys
AI_API_KEY=
# 可选：自定义 OpenAI 兼容端点与模型，留空则使用 AI_PROVIDER 对应预设
AI_BASE_URL=
AI_MODEL=
# 加密「存库 AI Key」的主密钥（未设置则回退 NEXTAUTH_SECRET）
# 警告：更换该值后，已保存的 AI Key 将无法解密，需要重新录入
AI_KEY_SECRET=

# ===== 邮箱验证码（登录 2FA）邮件发送 - 二选一 =====
# 后端自动选择：SMTP_* 齐全则走 SMTP；否则 RESEND_API_KEY 存在则走 Resend。
# 建议内部系统直接用 SMTP（QQ/163 等已验证域名，可发任意收件人，无需验证域名）。

# --- 方案 A：SMTP（推荐，最简单）---
# 优先级最高：SMTP_HOST/SMTP_USER/SMTP_PASS 都填了就用它
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# 是否使用 SSL：465 端口填 true；587(STARTTLS) 端口填 false（必填，不可留空）
SMTP_SECURE=true
SMTP_USER=你的完整邮箱，如 123456@qq.com
SMTP_PASS=邮箱授权码（不是登录密码，QQ 邮箱设置→账户→开启 POP3/SMTP 获取）
# 发件人显示名（留空则默认用 SMTP_USER），如 车位管理系统 <123456@qq.com>
MAIL_FROM=

# --- 方案 B：Resend（需先在后台验证发件域名）---
# 仅当未配置 SMTP_* 时生效。未验证域名前只能发往你注册 Resend 的邮箱。
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
